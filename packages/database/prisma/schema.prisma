// =============================================================================
// Butler — Agentic Business OS
// Phase 1 Prisma Schema
// Database: Supabase Postgres (Mumbai region)
//
// Notes:
//   - All timestamps are timestamptz (UTC) — format to user TZ in app layer
//   - RLS policies are NOT defined here; they live in supabase/migrations/*.sql
//   - pgmq queue tables and Supabase auth.users are not modelled here
//
// Phase 2 edits (2026-04-27):
//   - Added User.image (Google profile picture, synced on every login)
//   - Made User.email required (was nullable) — every dashboard user must have one
//   - Removed User.authUserId — Supabase Auth not in scope; NextAuth owns identity
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// =============================================================================
// IDENTITY & ORG
// =============================================================================

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Identity for the dashboard (NextAuth + Google OAuth).
  email             String    @unique
  // WhatsApp identity — how the agent finds the user.
  phoneE164         String    @unique @map("phone_e164")

  // Profile
  displayName       String    @map("display_name")
  image             String?   // Google profile picture URL — synced on every login
  role              UserRole  @default(member)
  teamId            String?   @map("team_id") @db.Uuid

  // Preferences
  languagePref      LanguagePref @default(hinglish) @map("language_pref")
  timezone          String       @default("Asia/Kolkata") // IANA tz name
  voiceReplyEnabled Boolean      @default(true) @map("voice_reply_enabled")

  // Lifecycle
  isActive          Boolean   @default(true) @map("is_active")
  optedInAt         DateTime? @map("opted_in_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  team              Team?                  @relation(fields: [teamId], references: [id])
  ledTeams          Team[]                 @relation("TeamLead")
  assignedTasks     Task[]                 @relation("TaskAssignee")
  createdTasks      Task[]                 @relation("TaskCreator")
  taskUpdates       TaskUpdate[]
  sessions          ConversationSession[]
  messages          ConversationMessage[]
  summaries         ConversationSummary[]
  weeklySummaries   ConversationWeeklySummary[]
  reminderSchedules ReminderSchedule[]
  messageProcessing MessageProcessing[]

  @@index([role])
  @@index([teamId])
  @@index([isActive])
}

enum UserRole {
  developer // platform staff (you + future devs) — full access, debug views
  admin     // org admin (CEO during Phase 1)
  director  // department head
  manager   // team lead
  member    // individual contributor
}

enum LanguagePref {
  english
  hindi
  hinglish
}

model Team {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  parentTeamId String?  @map("parent_team_id") @db.Uuid
  leadUserId   String?  @map("lead_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  parent       Team?    @relation("TeamHierarchy", fields: [parentTeamId], references: [id])
  children     Team[]   @relation("TeamHierarchy")
  lead         User?    @relation("TeamLead", fields: [leadUserId], references: [id])
  members      User[]

  @@index([parentTeamId])
}

// =============================================================================
// TASKS
// =============================================================================

model Task {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignedToId   String       @map("assigned_to") @db.Uuid
  createdById    String?      @map("created_by") @db.Uuid // null when created by agent
  title          String
  description    String?
  status         TaskStatus   @default(pending)
  priority       TaskPriority @default(medium)
  deadline       DateTime?
  deferredTo     DateTime?    @map("deferred_to")
  completedAt    DateTime?    @map("completed_at")
  source         MessageSource
  recurrence     Json?        // { pattern: 'daily', interval: 1, ... }
  tags           String[]     @default([])
  lastRemindedAt DateTime?    @map("last_reminded_at")
  reminderCount  Int          @default(0) @map("reminder_count")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  assignee       User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  creator        User?        @relation("TaskCreator", fields: [createdById], references: [id])
  updates        TaskUpdate[]

  @@index([assignedToId, status])
  @@index([deadline])
  @@index([assignedToId, deadline])
  @@index([status, deadline])
  @@index([isDeleted])
}

enum TaskStatus {
  pending
  in_progress
  done
  deferred
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum MessageSource {
  dashboard
  whatsapp_text
  whatsapp_voice
  agent
  system
  api
}

model TaskUpdate {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId                String               @map("task_id") @db.Uuid
  updatedById           String?              @map("updated_by") @db.Uuid
  updateType            TaskUpdateType       @map("update_type")
  source                MessageSource
  oldValue              Json?                @map("old_value")
  newValue              Json?                @map("new_value")
  conversationMessageId String?              @unique @map("conversation_message_id") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at")

  task                  Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  updatedBy             User?                @relation(fields: [updatedById], references: [id])
  conversationMessage   ConversationMessage? @relation(fields: [conversationMessageId], references: [id])

  @@index([taskId, createdAt(sort: Desc)])
  @@index([updateType])
}

enum TaskUpdateType {
  created
  status_changed
  priority_changed
  deadline_changed
  deferred
  reminded
  edited
  deleted
}

// =============================================================================
// CONVERSATION MEMORY
// =============================================================================

model ConversationSession {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String                @map("user_id") @db.Uuid
  startedAt                DateTime              @default(now()) @map("started_at")
  endedAt                  DateTime?             @map("ended_at")
  messageCount             Int                   @default(0) @map("message_count")
  elevenlabsConversationId String?               @unique @map("elevenlabs_conversation_id")
  channel                  ConversationChannel   @default(whatsapp)
  metadata                 Json                  @default("{}")
  createdAt                DateTime              @default(now()) @map("created_at")

  // ── Cost (extracted for analytics SUMs over time / per-user) ──
  costCredits              Int?                  @map("cost_credits")

  // ── Analysis (extracted for queries + list-view display) ──
  callSuccessful           String?               @map("call_successful")
  analysisTitle            String?               @map("analysis_title")
  analysisSummary          String?               @map("analysis_summary") @db.Text

  // ── WhatsApp context (extracted so we can filter "all from this phone") ──
  whatsappUserId           String?               @map("whatsapp_user_id")
  whatsappPhoneNumberId    String?               @map("whatsapp_phone_number_id")

  // ── ElevenLabs internals worth pulling out ──
  elevenlabsAgentId        String?               @map("elevenlabs_agent_id")
  mainLanguage             String?               @map("main_language")
  textOnly                 Boolean?              @map("text_only")

  // ── Full-fidelity drill-down blobs ──
  analysisRaw              Json?                 @map("analysis_raw")
  chargingRaw              Json?                 @map("charging_raw")

  user                     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages                 ConversationMessage[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), costCredits])
  @@index([callSuccessful, createdAt(sort: Desc)])
  @@index([whatsappUserId])
}

enum ConversationChannel {
  whatsapp
  dashboard_chat
}

model ConversationMessage {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  sessionId            String              @map("session_id") @db.Uuid
  direction            MessageDirection
  messageType          MessageType         @map("message_type")
  templateName         String?             @map("template_name")
  templateVariables    Json?               @map("template_variables")
  content              String              // text, or transcription for voice
  voiceUrl             String?             @map("voice_url")
  voiceDurationSeconds Int?                @map("voice_duration_seconds")
  agentToolCalls       Json?               @map("agent_tool_calls")
  whatsappMessageId    String?             @map("whatsapp_message_id")
  metadata             Json                @default("{}")
  createdAt            DateTime            @default(now()) @map("created_at")

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  session              ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  taskUpdate           TaskUpdate?
  processing           MessageProcessing?

  // NOTE: vector(1536) embedding column added in Phase 7 via raw migration.

  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt])
  @@index([whatsappMessageId])
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageType {
  text
  voice
  voice_transcribed
  template
  system
}

model ConversationSummary {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  summaryDate          DateTime @map("summary_date") @db.Date
  summaryText          String   @map("summary_text")
  keyDecisions         Json?    @map("key_decisions")
  taskStateSnapshot    Json?    @map("task_state_snapshot")
  emotionalTone        String?  @map("emotional_tone")
  communicationPattern String?  @map("communication_pattern")
  messageCount         Int?     @map("message_count")
  tokenCount           Int?     @map("token_count")
  createdAt            DateTime @default(now()) @map("created_at")

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, summaryDate])
  @@index([userId, summaryDate(sort: Desc)])
}

model ConversationWeeklySummary {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  weekStartDate     DateTime @map("week_start_date") @db.Date  // Monday of the week
  weekEndDate       DateTime @map("week_end_date") @db.Date    // Sunday
  summaryText       String   @map("summary_text")
  keyThemes         Json?    @map("key_themes")         // ["string", ...]
  taskMetrics       Json?    @map("task_metrics")       // { created, completed, deferred, completion_rate }
  productivityScore Int?     @map("productivity_score") // 1-10
  patternInsights   Json?    @map("pattern_insights")   // [{ type, observation }, ...]
  dailySummaryIds   String[] @default([]) @map("daily_summary_ids") @db.Uuid  // provenance — refs to ConversationSummary.id
  tokenCount        Int?     @map("token_count")
  createdAt         DateTime @default(now()) @map("created_at")

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate(sort: Desc)])
}

// =============================================================================
// REMINDER SCHEDULES (per-user config — NOT job runs, those go in Job)
// =============================================================================

model ReminderSchedule {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  slotName     ReminderSlot @map("slot_name")
  hourLocal    Int          @map("hour_local") // 0-23 in user's local TZ
  isEnabled    Boolean      @default(true) @map("is_enabled")
  templateName String       @map("template_name")
  conditions   Json?        // e.g. { "only_if_urgent_within_hours": 3 }
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slotName])
  @@index([userId])
}

enum ReminderSlot {
  morning_brief
  midday_check
  afternoon_pulse
  evening_wrap
}

// =============================================================================
// JOBS — generic scheduled / queued work (replaces "cron_runs")
// =============================================================================
// Adapted from the reference schema's Jobs model. Vendor-neutral:
// the lamatic* fields are replaced with externalRefId/externalStatus/output
// so any upstream service (ElevenLabs, Meta, etc.) can be tracked.
//
// Entity references (userId, taskId) are loose FKs — no @relation —
// so jobs can reference deleted entities without cascade headaches.
// =============================================================================

model Job {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobType        JobType   @map("job_type")
  status         JobStatus @default(pending)
  attempt        Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  scheduledFor   DateTime  @map("scheduled_for")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  durationMs     Int?      @map("duration_ms")

  // Job-specific input (e.g. template variables, user_id list, slot name)
  payload        Json      @default("{}")

  // Result fields — the cron-summary stats live here:
  //   { users_evaluated: 8, sent: 5, skipped: 3, skip_reasons: {...} }
  output         Json?
  externalRefId  String?   @map("external_ref_id") // e.g. ElevenLabs message id
  externalStatus Int?      @map("external_status") // upstream HTTP code if applicable
  error          String?

  // Loose entity references (no @relation, no cascade)
  userId         String?   @map("user_id") @db.Uuid
  taskId         String?   @map("task_id") @db.Uuid

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([jobType, status])
  @@index([scheduledFor])
  @@index([status, scheduledFor])
  @@index([userId])
  @@index([createdAt, jobType, status])
}

enum JobType {
  reminder_send         // outbound template send for a user/slot
  reminder_check_run    // hourly classifier sweep across all users
  daily_summarization   // midnight per-user summary generation
  weekly_summarization  // weekly per-user meta-summary across daily summaries
  whatsapp_quality_poll // daily Meta quality snapshot
  archive_messages      // move raw messages to Storage
  onboarding_optin      // send opt-in template to a new user
}

enum JobStatus {
  pending
  running
  success
  failed
  skipped
}

// =============================================================================
// OBSERVABILITY
// =============================================================================

model MessageProcessing {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationMessageId String?              @unique @map("conversation_message_id") @db.Uuid
  userId                String?              @map("user_id") @db.Uuid
  whatsappMessageId     String?              @map("whatsapp_message_id")
  receivedAt            DateTime?            @map("received_at")
  agentCalledAt         DateTime?            @map("agent_called_at")
  toolsCalledAt         DateTime?            @map("tools_called_at")
  dbUpdatedAt           DateTime?            @map("db_updated_at")
  replySentAt           DateTime?            @map("reply_sent_at")

  // Calculated in app layer on write (simpler than a generated column).
  totalLatencyMs        Int?                 @map("total_latency_ms")

  status                ProcessingStatus     @default(success)
  errorMessage          String?              @map("error_message")
  errorStack            String?              @map("error_stack")
  createdAt             DateTime             @default(now()) @map("created_at")

  conversationMessage   ConversationMessage? @relation(fields: [conversationMessageId], references: [id], onDelete: SetNull)
  user                  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, receivedAt(sort: Desc)])
  @@index([status, receivedAt(sort: Desc)])
}

enum ProcessingStatus {
  success
  partial
  failed
}

model WhatsappQualityLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneNumberId  String   @map("phone_number_id")
  qualityRating  String?  @map("quality_rating")  // GREEN | YELLOW | RED
  status         String?                          // CONNECTED | FLAGGED | RESTRICTED
  messagingLimit String?  @map("messaging_limit") // TIER_1K | TIER_10K | ...
  rawPayload     Json?    @map("raw_payload")
  checkedAt      DateTime @default(now()) @map("checked_at")

  @@index([phoneNumberId, checkedAt(sort: Desc)])
}

model WebhookAudit {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source           String                  // 'elevenlabs' | 'whatsapp_meta' | 'cost_tracker' | 'agent_<name>'
  eventType        String                  @map("event_type") // provider-specific event name
  eventId          String?                 @map("event_id")   // provider's primary id (e.g. ElevenLabs conversation_id)
  signatureValid   Boolean                 @default(false) @map("signature_valid")
  payload          Json
  headers          Json?                   // snapshot of relevant request headers
  processingStatus WebhookProcessingStatus @default(received) @map("processing_status")
  processingError  String?                 @map("processing_error")
  durationMs       Int?                    @map("duration_ms")

  // Loose entity refs — resolved during processing.
  // No @relation, no cascade — entities can be deleted without breaking audit history.
  userId           String?                 @map("user_id") @db.Uuid
  sessionId        String?                 @map("session_id") @db.Uuid

  receivedAt       DateTime                @default(now()) @map("received_at")
  processedAt      DateTime?               @map("processed_at")

  @@index([source, eventType, receivedAt(sort: Desc)])
  @@index([eventId])
  @@index([processingStatus, receivedAt(sort: Desc)])
  @@index([userId, receivedAt(sort: Desc)])
}

enum WebhookProcessingStatus {
  received       // arrived, no processing started
  invalid        // signature failed, malformed, or unsupported event
  completed      // processed successfully
  orphaned       // valid but no matching user/entity (logged, not an error)
  skipped        // intentional skip (e.g. audio events in POC)
  failed         // error during processing
}
