# Supabase
DATABASE_URL=                          # pooled connection (port 6543) — Prisma client
DIRECT_DATABASE_URL=                   # direct connection (port 5432) — Prisma migrations
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=             # backend only — bypasses RLS, never expose to client

# NextAuth (Auth.js v5)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=                           # generate: openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000     # set to deployed URL in prod
